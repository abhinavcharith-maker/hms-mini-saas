# Database Connection
# Local SQLite prototyping default:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example:
# DATABASE_URL="postgresql://hms_user:STRONG_PASSWORD@localhost:5432/hms_mini_saas?schema=public"

# Cryptographic secret used for signing/hashing operational helpers (generate a random 64-hex string in production)
SESSION_SECRET="replace-with-secure-random-64-char-hex-secret"

# Application URL
APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# Optional server-side fallback (recommended: configure directly in Super Admin -> Settings)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
